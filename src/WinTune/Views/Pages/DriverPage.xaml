<Page
    x:Class="WinTune.Views.Pages.DriverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Drivers"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded">
    <StackPanel Margin="32,24,32,32">
        <ui:TextBlock FontTypography="Title" Text="Drivers" />
        <ui:TextBlock
            Margin="0,2,0,12"
            FontTypography="Caption"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="Hardware detected on this PC and pages to download updated drivers from."
            TextWrapping="Wrap" />

        <ui:InfoBar
            x:Name="MessageBar"
            Margin="0,0,0,10"
            IsClosable="True"
            IsOpen="False" />

        <!--  Automatic Windows Update drivers  -->
        <ui:Card Margin="0,0,0,10" Padding="16">
            <StackPanel>
                <ui:TextBlock FontTypography="Subtitle" Text="Automatic drivers from Windows Update" />
                <ui:TextBlock
                    x:Name="AutoStateText"
                    Margin="0,6,0,2"
                    FontTypography="BodyStrong" />
                <ui:TextBlock
                    FontTypography="Caption"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="When disabled, Windows Update does not install or overwrite drivers: the ones you install stay. Manual installation always works."
                    TextWrapping="Wrap" />
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock
                        Margin="0,0,8,6"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Duration" />
                    <ComboBox
                        x:Name="DurationBox"
                        Width="190"
                        Margin="0,0,8,6"
                        VerticalAlignment="Center"
                        SelectedIndex="0"
                        SelectionChanged="OnDurationChanged">
                        <ComboBoxItem Content="No expiry" Tag="none" />
                        <ComboBoxItem Content="1 month" Tag="1" />
                        <ComboBoxItem Content="2 months" Tag="2" />
                        <ComboBoxItem Content="3 months" Tag="3" />
                        <ComboBoxItem Content="Until a date" Tag="date" />
                    </ComboBox>
                    <DatePicker
                        x:Name="UntilPicker"
                        Width="170"
                        Margin="0,0,8,6"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <ui:Button
                        x:Name="BlockButton"
                        Margin="0,0,8,6"
                        Appearance="Primary"
                        Click="OnBlockClick"
                        Content="Turn off automatic drivers" />
                    <ui:Button
                        x:Name="UnblockButton"
                        Margin="0,0,8,6"
                        Click="OnUnblockClick"
                        Content="Turn back on now" />
                </WrapPanel>
            </StackPanel>
        </ui:Card>

        <!--  Detected hardware and links  -->
        <ui:Card Padding="16">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock FontTypography="Subtitle" Text="Hardware and driver pages" />
                        <ui:TextBlock
                            Margin="0,2,0,0"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Each component has a suggested link. With the pencil you replace it with the exact page: it is saved in the profile."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        Click="OnDetectClick"
                        Content="Detect again"
                        Icon="{ui:SymbolIcon ArrowSync24}" />
                </Grid>

                <ItemsControl x:Name="HardwareList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="0,5"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid MinHeight="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Type}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Model}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Detail}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding DetailVisibility}" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="OnOpenLinkClick"
                                        Content="Open page"
                                        Icon="{ui:SymbolIcon Open24}"
                                        ToolTip="{Binding Link}" />
                                    <ui:Button
                                        Grid.Column="3"
                                        Margin="6,0,0,0"
                                        Padding="6"
                                        VerticalAlignment="Center"
                                        Click="OnEditLinkClick"
                                        Icon="{ui:SymbolIcon Edit24}"
                                        ToolTip="{Binding LinkNote}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
