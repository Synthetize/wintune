<Page
    x:Class="WinTune.Views.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Overview"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded">
    <StackPanel Margin="32,24,32,32">
        <ui:TextBlock FontTypography="Title" Text="Overview" />
        <ui:TextBlock
            x:Name="HardwareText"
            Margin="0,2,0,12"
            FontTypography="Caption"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <!--  Profile state  -->
        <ui:InfoBar
            x:Name="ProfileBar"
            Margin="0,0,0,8"
            IsClosable="False"
            IsOpen="True" />

        <WrapPanel Margin="0,0,0,12">
            <ui:Button
                x:Name="ReapplyButton"
                Margin="0,0,8,6"
                Appearance="Primary"
                Click="OnReapplyClick"
                Content="Reapply profile"
                Icon="{ui:SymbolIcon ArrowSync24}" />
            <ui:Button
                Margin="0,0,8,6"
                Click="OnSaveProfileClick"
                Content="Save the current state as a profile"
                Icon="{ui:SymbolIcon Save24}" />
        </WrapPanel>

        <!--  Start with Windows  -->
        <Border
            Margin="0,0,0,12"
            Padding="12,8"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Start WinTune with Windows" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Opens the window minimized when you sign in."
                        TextWrapping="Wrap" />
                </StackPanel>
                <ui:ToggleSwitch
                    x:Name="StartupSwitch"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Click="OnStartWithWindowsClick" />
            </Grid>
            <Border
                Height="1"
                Margin="0,8,0,8"
                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Minimize on close" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="The X button keeps WinTune running in the notification area. Click its icon to reopen it, right-click to exit. Off: the X closes WinTune."
                        TextWrapping="Wrap" />
                </StackPanel>
                <ui:ToggleSwitch
                    x:Name="CloseActionSwitch"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Click="OnCloseActionClick" />
            </Grid>
            </StackPanel>
        </Border>

        <!--  Differences from the profile  -->
        <StackPanel
            x:Name="DifferencesPanel"
            Margin="0,0,0,12"
            Visibility="Collapsed">
            <ui:TextBlock
                Margin="0,0,0,6"
                FontTypography="Subtitle"
                Text="Changed settings" />
            <ItemsControl x:Name="DifferencesList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="0,4"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Detail}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!--  Checks  -->
        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
            <ui:TextBlock
                VerticalAlignment="Center"
                FontTypography="Subtitle"
                Text="Checks" />
            <ui:Button
                x:Name="RefreshChecksButton"
                Margin="12,0,0,0"
                Padding="6"
                VerticalAlignment="Center"
                Click="OnRefreshClick"
                Icon="{ui:SymbolIcon ArrowSync24}"
                ToolTip="Run the checks again" />
            <ui:ProgressRing
                x:Name="ChecksRing"
                Width="16"
                Height="16"
                Margin="10,0,0,0"
                IsIndeterminate="True"
                Visibility="Collapsed" />
        </StackPanel>

        <ItemsControl
            x:Name="ChecksList"
            Margin="0,0,0,8"
            Focusable="False"
            Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!--  The shared row makes all the tiles as tall as the tallest  -->
                    <Grid Width="264" Margin="0,0,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="CheckTile" />
                        </Grid.RowDefinitions>
                        <Border
                            Padding="10,8,10,10"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            Cursor="{Binding TileCursor}"
                            MouseLeftButtonUp="OnCheckTileClick"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding StatusBrush}"
                                        Text="{Binding StatusText}" />
                                </Grid>
                                <TextBlock
                                    Margin="0,4,0,2"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding Value}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Detail}"
                                    TextWrapping="Wrap" />
                                <ui:Button
                                    Margin="0,8,0,0"
                                    Click="OnCheckActionClick"
                                    Content="{Binding ActionText}"
                                    Visibility="{Binding ActionVisibility}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Drives  -->
        <ui:TextBlock
            Margin="0,8,0,2"
            FontTypography="Subtitle"
            Text="Storage" />
        <ui:TextBlock
            Margin="0,0,0,6"
            FontTypography="Caption"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="Click a drive to open Tools, where SpaceSniffer shows what takes up the space."
            TextWrapping="Wrap" />
        <ItemsControl
            x:Name="DrivesList"
            Margin="0,0,0,12"
            Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Width="264"
                        Margin="0,0,8,8"
                        Padding="10,8,10,10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Cursor="Hand"
                        MouseLeftButtonUp="OnDriveTileClick">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding BarBrush}"
                                    Text="{Binding LowText}"
                                    Visibility="{Binding LowVisibility}" />
                            </Grid>
                            <ProgressBar
                                Height="8"
                                Margin="0,8,0,6"
                                Foreground="{Binding BarBrush}"
                                Maximum="100"
                                Value="{Binding UsedPercent, Mode=OneWay}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding FreeText}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Reminders and OC notes, side by side  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Card
                Grid.Column="0"
                Padding="16"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Top">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle" Text="Reminders" />
                    <ui:TextBlock
                        Margin="0,2,0,6"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Things to check by hand, which Windows cannot verify."
                        TextWrapping="Wrap" />
                    <ItemsControl x:Name="RemindersList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox
                                    MinWidth="0"
                                    MinHeight="26"
                                    Padding="4,2"
                                    IsChecked="{Binding IsDone, Mode=TwoWay}">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            x:Name="NewReminderBox"
                            Grid.Column="0"
                            KeyDown="OnNewReminderKeyDown"
                            PlaceholderText="New reminder" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Click="OnAddReminderClick"
                            Content="Add"
                            Icon="{ui:SymbolIcon Add24}" />
                    </Grid>
                    <ui:Button
                        Margin="0,8,0,0"
                        Click="OnRemoveDoneRemindersClick"
                        Content="Remove the ticked ones"
                        Icon="{ui:SymbolIcon Delete24}" />
                </StackPanel>
            </ui:Card>

            <ui:Card
                Grid.Column="2"
                Padding="16"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Top">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle" Text="OC notes" />
                    <ui:TextBlock
                        Margin="0,2,0,6"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Values set in the BIOS (PBO, Curve Optimizer, RAM profile, fans). They are kept in the profile."
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="OcNotesBox"
                        MinHeight="120"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <ui:Button
                            Click="OnSaveNotesClick"
                            Content="Save notes"
                            Icon="{ui:SymbolIcon Save24}" />
                        <TextBlock
                            x:Name="NotesStatusText"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </Grid>
    </StackPanel>
</Page>
