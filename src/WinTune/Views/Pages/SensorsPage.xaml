<Page
    x:Class="WinTune.Views.Pages.SensorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Sensors"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <StackPanel Margin="32,24,32,32">
        <ui:TextBlock FontTypography="Title" Text="Sensors" />
        <ui:TextBlock
            Margin="0,2,0,12"
            FontTypography="Caption"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="Live temperatures, load, clocks, power and fans. Minimum and maximum are since WinTune started."
            TextWrapping="Wrap" />

        <ui:InfoBar
            x:Name="MessageBar"
            Margin="0,0,0,10"
            IsClosable="True"
            IsOpen="False" />

        <!--  Driver missing  -->
        <StackPanel
            x:Name="DriverPanel"
            Margin="0,0,0,10"
            Visibility="Collapsed">
            <ui:InfoBar
                x:Name="DriverBar"
                IsClosable="False"
                IsOpen="True"
                Severity="Warning"
                Title="Some sensors are missing" />
            <WrapPanel Margin="0,6,0,0">
                <ui:Button
                    x:Name="InstallDriverButton"
                    Margin="0,0,8,6"
                    Appearance="Primary"
                    Click="OnInstallDriverClick"
                    Content="Install PawnIO driver"
                    Icon="{ui:SymbolIcon ArrowDownload24}" />
                <ui:Button
                    Margin="0,0,8,6"
                    Click="OnReloadClick"
                    Content="Reload sensors"
                    Icon="{ui:SymbolIcon ArrowSync24}" />
            </WrapPanel>
        </StackPanel>

        <!--  Filter  -->
        <WrapPanel Margin="0,0,0,8">
            <TextBlock
                Margin="0,0,8,6"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Show" />
            <ComboBox
                x:Name="FilterBox"
                Width="170"
                Margin="0,0,8,6"
                VerticalAlignment="Center"
                SelectedIndex="0"
                SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="Everything" Tag="All" />
                <ComboBoxItem Content="Temperatures" Tag="Temperature" />
                <ComboBoxItem Content="Load" Tag="Load" />
                <ComboBoxItem Content="Clocks" Tag="Clock" />
                <ComboBoxItem Content="Power" Tag="Power" />
                <ComboBoxItem Content="Fans" Tag="Fan" />
                <ComboBoxItem Content="Voltages" Tag="Voltage" />
                <ComboBoxItem Content="Memory" Tag="Data" />
            </ComboBox>
            <ui:ProgressRing
                x:Name="LoadRing"
                Width="18"
                Height="18"
                Margin="4,0,0,6"
                IsIndeterminate="True" />
        </WrapPanel>

        <!--  One tile per component  -->
        <ItemsControl
            x:Name="GroupsList"
            Margin="0,0,0,8"
            Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,8"
                        Padding="12,8,12,10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding TypeLabel}" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                            </StackPanel>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Now" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Min" />
                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Max" />
                            </Grid>
                            <ItemsControl Focusable="False" ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="0,3"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding KindLabel, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding ValueBrush}"
                                                    Text="{Binding ValueText}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding MinText}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    HorizontalAlignment="Right"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding MaxText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Before/after snapshots  -->
        <ui:Card Padding="16">
            <StackPanel>
                <ui:TextBlock FontTypography="Subtitle" Text="Before and after" />
                <ui:TextBlock
                    Margin="0,2,0,8"
                    FontTypography="Caption"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Save a snapshot before changing settings or overclocking, then compare it with the current values. Take both at a similar load (for example idle) for a fair comparison."
                    TextWrapping="Wrap" />
                <WrapPanel>
                    <ui:Button
                        Margin="0,0,8,6"
                        Click="OnSaveSnapshotClick"
                        Content="Save snapshot"
                        Icon="{ui:SymbolIcon Camera24}" />
                    <ComboBox
                        x:Name="SnapshotBox"
                        Width="280"
                        Margin="0,0,8,6"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Label" />
                    <ui:Button
                        Margin="0,0,8,6"
                        Appearance="Primary"
                        Click="OnCompareClick"
                        Content="Compare with now"
                        Icon="{ui:SymbolIcon ArrowSwap24}" />
                    <ui:Button
                        Margin="0,0,8,6"
                        Click="OnDeleteSnapshotClick"
                        Content="Delete"
                        Icon="{ui:SymbolIcon Delete24}" />
                </WrapPanel>

                <Grid
                    x:Name="CompareHeader"
                    Margin="0,6,0,0"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="CompareTitle"
                        Grid.Column="0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Then" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Now" />
                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Change" />
                </Grid>

                <ItemsControl
                    x:Name="CompareList"
                    Margin="0,2,0,0"
                    Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="0,3"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Hardware, Mode=OneWay}" />
                                        <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Name, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ThenText}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        Text="{Binding NowText}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding DeltaBrush}"
                                        Text="{Binding DeltaText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
