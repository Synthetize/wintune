<Page
    x:Class="WinTune.Views.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Updates"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded">
    <StackPanel Margin="32,24,32,32">
        <ui:TextBlock FontTypography="Title" Text="Updates" />
        <ui:TextBlock
            Margin="0,2,0,12"
            FontTypography="Caption"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="How Windows Update behaves on this PC."
            TextWrapping="Wrap" />

        <ui:InfoBar
            x:Name="MessageBar"
            Margin="0,0,0,10"
            IsClosable="True"
            IsOpen="False" />

        <!--  Mode  -->
        <ui:Card Margin="0,0,0,10" Padding="16">
            <StackPanel>
                <ui:TextBlock FontTypography="Subtitle" Text="Windows Update mode" />
                <ui:TextBlock
                    x:Name="StateText"
                    Margin="0,6,0,10"
                    FontTypography="BodyStrong" />

                <WrapPanel Grid.IsSharedSizeScope="True">
                    <Grid Width="250" Margin="0,0,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="ModeTile" />
                        </Grid.RowDefinitions>
                    <Border
                        Padding="8,6,10,8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel>
                            <RadioButton
                                x:Name="ModeEnabled"
                                Checked="OnModeChecked"
                                Content="Enabled"
                                FontWeight="SemiBold"
                                GroupName="UpdateMode" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Normal Windows behavior: it downloads and installs by itself."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    </Grid>
                    <Grid Width="250" Margin="0,0,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="ModeTile" />
                        </Grid.RowDefinitions>
                    <Border
                        Padding="8,6,10,8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel>
                            <RadioButton
                                x:Name="ModeNotifyOnly"
                                Checked="OnModeChecked"
                                Content="Notify only"
                                FontWeight="SemiBold"
                                GroupName="UpdateMode" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Windows tells you there are updates; it downloads and installs only when you decide."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    </Grid>
                    <Grid Width="250" Margin="0,0,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="ModeTile" />
                        </Grid.RowDefinitions>
                    <Border
                        Padding="8,6,10,8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel>
                            <RadioButton
                                x:Name="ModePaused"
                                Checked="OnModeChecked"
                                Content="Paused"
                                FontWeight="SemiBold"
                                GroupName="UpdateMode" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Suspended until the chosen date, then they resume by themselves."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    </Grid>
                    <Grid Width="250" Margin="0,0,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="ModeTile" />
                        </Grid.RowDefinitions>
                    <Border
                        Padding="8,6,10,8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel>
                            <RadioButton
                                x:Name="ModeDisabled"
                                Checked="OnModeChecked"
                                Content="Disabled"
                                FontWeight="SemiBold"
                                GroupName="UpdateMode" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="No automatic updates, so no security fixes. Not recommended without an expiry."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </WrapPanel>

                <WrapPanel Margin="0,6,0,0">
                    <TextBlock
                        x:Name="DurationLabel"
                        Margin="0,0,8,6"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Duration" />
                    <ComboBox
                        x:Name="DurationBox"
                        Width="190"
                        Margin="0,0,8,6"
                        VerticalAlignment="Center"
                        SelectedIndex="2"
                        SelectionChanged="OnDurationChanged">
                        <ComboBoxItem Content="1 week" Tag="7d" />
                        <ComboBoxItem Content="2 weeks" Tag="14d" />
                        <ComboBoxItem Content="1 month" Tag="1" />
                        <ComboBoxItem Content="2 months" Tag="2" />
                        <ComboBoxItem Content="3 months" Tag="3" />
                        <ComboBoxItem Content="Until a date" Tag="date" />
                        <ComboBoxItem Content="No expiry" Tag="none" />
                    </ComboBox>
                    <DatePicker
                        x:Name="UntilPicker"
                        Width="170"
                        Margin="0,0,8,6"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <ui:Button
                        Margin="0,0,8,6"
                        Appearance="Primary"
                        Click="OnApplyClick"
                        Content="Apply"
                        Icon="{ui:SymbolIcon Checkmark24}" />
                </WrapPanel>
                <ui:TextBlock
                    Margin="0,2,0,0"
                    FontTypography="Caption"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="The duration applies to “Paused” and “Disabled”. “No expiry” is only possible for “Disabled”. When it expires, updates turn back on by themselves, even with WinTune closed."
                    TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>

        <!--  Drivers  -->
        <ui:Card Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="BodyStrong" Text="Automatic drivers" />
                    <ui:TextBlock
                        x:Name="DriverStateText"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ui:Button
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Click="OnOpenDriverPageClick"
                    Content="Open the Drivers section" />
            </Grid>
        </ui:Card>
    </StackPanel>
</Page>
