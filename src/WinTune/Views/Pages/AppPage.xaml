<Page
    x:Class="WinTune.Views.Pages.AppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Apps"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <StackPanel Margin="32,24,32,32">
        <ui:TextBlock FontTypography="Title" Text="Apps" />
        <StackPanel Margin="0,2,0,12" Orientation="Horizontal">
            <ui:TextBlock
                x:Name="WingetStatusText"
                VerticalAlignment="Center"
                FontTypography="Caption"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Checking winget..." />
            <ui:ProgressRing
                x:Name="WingetRing"
                Width="14"
                Height="14"
                Margin="10,0,0,0"
                IsIndeterminate="True"
                Visibility="Collapsed" />
        </StackPanel>

        <ui:InfoBar
            x:Name="MessageBar"
            Margin="0,0,0,10"
            IsClosable="True"
            IsOpen="False" />

        <!--  Section buttons, same style as the Optimizations filter  -->
        <WrapPanel x:Name="SectionPanel" Margin="0,0,0,8">
            <ToggleButton Margin="0,0,8,8" Click="OnSectionClick" Content="Updates" IsChecked="True" Tag="Updates" />
            <ToggleButton Margin="0,0,8,8" Click="OnSectionClick" Content="Install" Tag="Install" />
            <ToggleButton Margin="0,0,8,8" Click="OnSectionClick" Content="Uninstall" Tag="Uninstall" />
            <ToggleButton Margin="0,0,8,8" Click="OnSectionClick" Content="Preinstalled" Tag="Preinstalled" />
            <ToggleButton Margin="0,0,8,8" Click="OnSectionClick" Content="Startup" Tag="Startup" />
        </WrapPanel>

        <Grid>
            <StackPanel x:Name="UpdatesPanel">
                <!--  App updates  -->
                <ui:Card Margin="0,0,0,10" Padding="16">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="App updates" />
                        <TextBlock
                            x:Name="UpgradeStatusText"
                            Margin="0,2,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Checking for updates..."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Tick the apps and press the button: updates always run with administrator rights."
                            TextWrapping="Wrap" />
                        <ItemsControl x:Name="UpgradeList" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Width="270"
                                        MinHeight="44"
                                        Padding="4,2"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                        ToolTip="{Binding Id}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Detail}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Failed updates: the full reason, which does not fit in the tiles  -->
                        <Border
                            x:Name="UpgradeErrorsPanel"
                            Margin="0,8,0,0"
                            Padding="12,8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontWeight="SemiBold"
                                    Text="Failed updates" />
                                <ItemsControl x:Name="UpgradeErrorsList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2,0,4">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Message}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button
                                x:Name="UpgradeButton"
                                Margin="0,0,1,0"
                                Appearance="Primary"
                                Click="OnUpgradeSelectedClick"
                                Content="Update as administrator"
                                Icon="{ui:SymbolIcon ArrowUpload24}"
                                ToolTip="Updates the selected apps with administrator rights" />
                            <!--  Arrow next to the button: other ways to update  -->
                            <ui:Button
                                x:Name="UpgradeMenuButton"
                                Margin="0,0,8,0"
                                Padding="6,0"
                                VerticalAlignment="Stretch"
                                Appearance="Primary"
                                Click="OnUpgradeMenuClick"
                                Icon="{ui:SymbolIcon ChevronDown24}"
                                ToolTip="Other ways to update">
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Click="OnUpgradeSelectedClick" Header="Update as administrator" />
                                        <MenuItem Click="OnUpgradeInteractiveClick" Header="Update as administrator, showing the installer" />
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                            <ui:Button
                                x:Name="UpgradeSelectAllButton"
                                Margin="0,0,8,0"
                                Click="OnSelectAllUpgradesClick"
                                Content="Select all" />
                            <ui:Button
                                x:Name="UpgradeClearButton"
                                Margin="0,0,8,0"
                                Click="OnClearUpgradesClick"
                                Content="Deselect all" />
                            <ui:Button
                                x:Name="IgnoreUpgradesButton"
                                Margin="0,0,8,0"
                                Click="OnIgnoreSelectedClick"
                                Content="Ignore selected"
                                ToolTip="Stops offering updates for the selected apps until you re-enable them" />
                            <ui:Button
                                x:Name="CheckUpgradesButton"
                                Margin="0,0,8,0"
                                Click="OnCheckUpgradesClick"
                                Content="Check for updates"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                            <ui:ProgressRing
                                x:Name="UpgradeRing"
                                Width="20"
                                Height="20"
                                Margin="6,0,0,0"
                                IsIndeterminate="True"
                                Visibility="Collapsed" />
                        </WrapPanel>

                        <!--  Ignored updates: re-enable them from here  -->
                        <Expander
                            x:Name="IgnoredExpander"
                            Margin="0,10,0,0"
                            Header="Ignored updates"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Updates for these apps are not offered until you re-enable them."
                                    TextWrapping="Wrap" />
                                <ItemsControl x:Name="IgnoredList" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Width="270"
                                                MinHeight="44"
                                                Padding="4,2"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                ToolTip="{Binding Id}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Detail}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button
                                    x:Name="RestoreIgnoredButton"
                                    Margin="0,8,0,0"
                                    Click="OnRestoreIgnoredClick"
                                    Content="Re-enable selected"
                                    Icon="{ui:SymbolIcon History24}" />
                            </StackPanel>
                        </Expander>

                        <!--  Background notifications  -->
                        <Border
                            Height="1"
                            Margin="0,12,0,10"
                            Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock FontWeight="SemiBold" Text="Notifications" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Notify me about new app updates" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Checks with winget in the background, even when WinTune is closed, and shows a Windows notification. Ignored updates are skipped."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                x:Name="NotifySwitch"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Click="OnNotifyClick" />
                        </Grid>

                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock
                                Margin="0,0,8,6"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Check every" />
                            <ComboBox
                                x:Name="IntervalBox"
                                Width="130"
                                Margin="0,0,8,6"
                                VerticalAlignment="Center"
                                SelectionChanged="OnIntervalChanged">
                                <ComboBoxItem Content="3 hours" Tag="3" />
                                <ComboBoxItem Content="6 hours" Tag="6" />
                                <ComboBoxItem Content="12 hours" Tag="12" />
                                <ComboBoxItem Content="24 hours" Tag="24" />
                            </ComboBox>
                            <ui:Button
                                Margin="0,0,8,6"
                                Click="OnTestNotificationClick"
                                Content="Send a test notification"
                                Icon="{ui:SymbolIcon Alert24}" />
                        </WrapPanel>
                        <TextBlock
                            x:Name="BackgroundStatusText"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

            </StackPanel>
            <StackPanel x:Name="InstallPanel" Visibility="Collapsed">
                <!--  Install apps: add bar at the top, categories side by side, actions at the bottom  -->
                <ui:Card Margin="0,0,0,10" Padding="16">
                    <StackPanel>
                        <ui:TextBlock
                            Margin="0,0,0,10"
                            FontTypography="Subtitle"
                            Text="Install apps" />

                        <!--  Bar to add apps  -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                x:Name="SearchBox"
                                Grid.Column="0"
                                KeyDown="OnSearchKeyDown"
                                PlaceholderText="Type the name of an app to add"
                                TextChanged="OnSearchTextChanged" />
                            <ui:Button
                                x:Name="SearchButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Click="OnSearchClick"
                                Content="Search"
                                Icon="{ui:SymbolIcon Search24}" />
                            <ui:Button
                                x:Name="DetectButton"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Click="OnDetectInstalledClick"
                                Content="Detect installed"
                                ToolTip="Finds the apps already installed on this PC that are not in the list yet" />
                            <TextBlock
                                Grid.Column="3"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Category" />
                            <ComboBox
                                x:Name="TargetCategoryBox"
                                Grid.Column="4"
                                Width="190"
                                VerticalAlignment="Center"
                                IsEditable="True"
                                ToolTip="Category to add the apps to: pick one or type a new name" />
                            <ui:ProgressRing
                                x:Name="SearchRing"
                                Grid.Column="5"
                                Width="18"
                                Height="18"
                                Margin="10,0,0,0"
                                IsIndeterminate="True"
                                Visibility="Collapsed" />
                        </Grid>

                        <!--  Search or detection results  -->
                        <Border
                            x:Name="ResultsPanel"
                            Margin="0,0,0,12"
                            Padding="12,8,12,10"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <StackPanel>
                                <ui:TextBlock
                                    x:Name="ResultsTitle"
                                    Margin="0,0,0,4"
                                    FontTypography="BodyStrong" />
                                <ItemsControl x:Name="SearchResults" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Width="270"
                                                MinHeight="26"
                                                Padding="4,2"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                ToolTip="{Binding Detail}">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <ui:Button
                                        Appearance="Primary"
                                        Click="OnAddSelectedResultsClick"
                                        Content="Add selected"
                                        Icon="{ui:SymbolIcon Add24}" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Click="OnSelectAllResultsClick"
                                        Content="Select all" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Click="OnCloseResultsClick"
                                        Content="Close" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Categories, side by side  -->
                        <ItemsControl
                            x:Name="CategoriesList"
                            Focusable="False"
                            Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--  The shared row makes all the tiles as tall as the tallest  -->
                                    <Grid Width="264" Margin="0,0,8,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" SharedSizeGroup="CategoryTile" />
                                        </Grid.RowDefinitions>
                                    <Border
                                        Padding="8,4,8,8"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    Grid.Column="0"
                                                    MinWidth="0"
                                                    MinHeight="28"
                                                    Padding="4,2"
                                                    IsChecked="{Binding AllSelected, Mode=TwoWay}"
                                                    ToolTip="Select or deselect the whole category">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Header}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </CheckBox>
                                                <ui:Button
                                                    Grid.Column="1"
                                                    Padding="3"
                                                    VerticalAlignment="Center"
                                                    Appearance="Danger"
                                                    BorderThickness="0"
                                                    Click="OnDeleteCategoryClick"
                                                    Icon="{ui:SymbolIcon Delete24}"
                                                    ToolTip="Delete the category" />
                                            </Grid>
                                            <Border
                                                Height="1"
                                                Margin="0,2,0,4"
                                                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                            <ItemsControl Focusable="False" ItemsSource="{Binding Apps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox
                                                                Grid.Column="0"
                                                                MinWidth="0"
                                                                MinHeight="26"
                                                                Padding="4,2"
                                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                ToolTip="{Binding Id}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        FontSize="10"
                                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                        Text="{Binding Location}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        Visibility="{Binding LocationVisibility}" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                            <ui:Button
                                                                Grid.Column="2"
                                                                Margin="4,0,0,0"
                                                                Padding="3"
                                                                VerticalAlignment="Center"
                                                                BorderThickness="0"
                                                                Click="OnSetLocationClick"
                                                                Icon="{ui:SymbolIcon Folder24}"
                                                                ToolTip="{Binding LocationTip}" />
                                                            <ui:Button
                                                                Grid.Column="3"
                                                                Margin="2,0,0,0"
                                                                Padding="3"
                                                                VerticalAlignment="Center"
                                                                BorderThickness="0"
                                                                Click="OnClearLocationClick"
                                                                Icon="{ui:SymbolIcon Dismiss24}"
                                                                ToolTip="Use the default folder"
                                                                Visibility="{Binding LocationVisibility}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Margin="6,0,2,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding ShortStatus}"
                                                                ToolTip="{Binding Status}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  New category  -->
                        <StackPanel Margin="0,2,0,10" Orientation="Horizontal">
                            <ui:TextBox
                                x:Name="NewCategoryBox"
                                Width="240"
                                VerticalAlignment="Center"
                                KeyDown="OnNewCategoryKeyDown"
                                PlaceholderText="Name of the new category" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Click="OnAddCategoryClick"
                                Content="Create category"
                                Icon="{ui:SymbolIcon Add24}" />
                        </StackPanel>

                        <!--  Actions on the selected apps  -->
                        <WrapPanel Margin="0,6,0,0">
                            <ui:Button
                                x:Name="InstallButton"
                                Margin="0,0,8,6"
                                Appearance="Primary"
                                Click="OnInstallClick"
                                Content="Install selected"
                                Icon="{ui:SymbolIcon ArrowDownload24}" />
                            <ui:Button
                                x:Name="RefreshAppsButton"
                                Margin="0,0,8,6"
                                Click="OnRefreshAppsClick"
                                Content="Refresh status"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                            <ui:Button
                                x:Name="RemoveFromListButton"
                                Margin="0,0,8,6"
                                Click="OnRemoveSelectedClick"
                                Content="Remove from list (does not uninstall)"
                                Icon="{ui:SymbolIcon Dismiss24}"
                                ToolTip="Removes the selected apps from the list. They stay installed on the PC." />
                            <ui:ProgressRing
                                x:Name="InstallRing"
                                Width="20"
                                Height="20"
                                Margin="6,0,8,6"
                                IsIndeterminate="True"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="InstallStatusText"
                                Margin="4,0,0,6"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </WrapPanel>
                    </StackPanel>
                </ui:Card>

            </StackPanel>
            <StackPanel x:Name="UninstallPanel" Visibility="Collapsed">
                <!--  Uninstall apps: scrollable list of the installed programs, with a tick for each  -->
                <ui:Card Margin="0,0,0,10" Padding="16">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="Uninstall apps" />
                        <ui:TextBlock
                            Margin="0,2,0,8"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Programs installed on this PC, in alphabetical order. Tick the ones to remove and press the button: they are uninstalled one after the other, silently when the program allows it. Recommended: first create a restore point from the Utilities section."
                            TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                x:Name="UninstallFilterBox"
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                PlaceholderText="Filter by name"
                                TextChanged="OnUninstallFilterChanged" />
                            <ui:Button
                                x:Name="UninstallRefreshButton"
                                Grid.Column="1"
                                Click="OnUninstallRefreshClick"
                                Content="Refresh list"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                        </Grid>
                        <TextBlock
                            x:Name="UninstallCountText"
                            Margin="0,0,0,6"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Reading installed apps..."
                            TextWrapping="Wrap" />
                        <Border
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="UninstallList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Margin="6,0,6,0"
                                                Padding="4,2"
                                                HorizontalAlignment="Stretch"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                ToolTip="{Binding Detail}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="10,0,0,0"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Status}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button
                                x:Name="UninstallButton"
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                Click="OnUninstallClick"
                                Content="Uninstall selected"
                                Icon="{ui:SymbolIcon Delete24}" />
                            <ui:Button
                                x:Name="UninstallClearButton"
                                Margin="0,0,8,0"
                                Click="OnUninstallClearClick"
                                Content="Deselect all" />
                            <ui:ProgressRing
                                x:Name="UninstallRing"
                                Width="20"
                                Height="20"
                                Margin="6,0,0,0"
                                IsIndeterminate="True"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="UninstallStatusText"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </WrapPanel>
                    </StackPanel>
                </ui:Card>

            </StackPanel>
            <StackPanel x:Name="PreinstalledPanel" Visibility="Collapsed">
                <!--  Preinstalled apps  -->
                <ui:Card Margin="0,0,0,10" Padding="16">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="Preinstalled apps" />
                        <ui:TextBlock
                            Margin="0,2,0,8"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Windows apps on this PC that you can remove; they can be reinstalled from the Microsoft Store. Recommended: first create a restore point from the Utilities section."
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="BloatStatusText"
                            Margin="0,0,0,6"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Reading installed apps..."
                            TextWrapping="Wrap" />
                        <ItemsControl x:Name="BloatList" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Width="270"
                                        MinHeight="26"
                                        Padding="4,2"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                        ToolTip="{Binding Package}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button
                                x:Name="RemoveBloatButton"
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                Click="OnRemoveBloatClick"
                                Content="Remove selected"
                                Icon="{ui:SymbolIcon Delete24}" />
                            <ui:Button
                                Margin="0,0,8,0"
                                Click="OnSelectRecommendedBloatClick"
                                Content="Select recommended" />
                            <ui:Button
                                Margin="0,0,8,0"
                                Click="OnClearBloatSelectionClick"
                                Content="Deselect all" />
                            <ui:ProgressRing
                                x:Name="BloatRing"
                                Width="20"
                                Height="20"
                                Margin="6,0,0,0"
                                IsIndeterminate="True"
                                Visibility="Collapsed" />
                        </WrapPanel>
                    </StackPanel>
                </ui:Card>

            </StackPanel>
            <StackPanel x:Name="StartupPanel" Visibility="Collapsed">
                <!--  Automatic start  -->
                <ui:Card Padding="16">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="Startup" />
                        <ui:TextBlock
                            Margin="0,2,0,8"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Programs that start with Windows. Turning them off here is the same as doing it from Task Manager. Store apps are managed from Windows Settings."
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="StartupStatusText"
                            Margin="0,0,0,6"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <ItemsControl x:Name="StartupList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="0,3"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid ToolTip="{Binding Command}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Image
                                                    Width="20"
                                                    Height="20"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    Source="{Binding Icon}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Source}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding StateText}" />
                                            <ui:ToggleSwitch
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </Grid>
    </StackPanel>
</Page>
